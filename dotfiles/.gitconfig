[user]
    name  = zinkosuke
    email = 48650930+zinkosuke@users.noreply.github.com
[color]
    ui = auto
[core]
    autocrlf     = false
    editor       = vim
    excludesfile = ~/.gitignore
    ignorecase   = false
    pager        = less -rN
    quotepath    = false
[diff]
    algorithm  = histogram
    colorMoved = plain
    renames    = true
    tool       = vimdiff
[difftool]
    prompt = false
[fetch]
    all   = true
    prune = true
[init]
    defaultBranch = main
[merge]
    ff = false
[pull]
    ff = only
[push]
    autoSetupRemote = true
    default         = current

[ghq]
    root = ~/ghq

[diff "sopsdiffer"]
	textconv = sops -d
